{
  "name": "edge-gig-marketplace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/gigFilters.test.ts src/lib/reliability.test.ts",
    "test:rules:unit": "tsx --test tests/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-edge \"npm run test:rules:unit\"",
    "verify": "npm run lint && npm test && npm run build && npm run lint --prefix functions && npm run build --prefix functions"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^14.12.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.2"
  }
}
