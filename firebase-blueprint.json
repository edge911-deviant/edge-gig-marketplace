{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for both organisers and artists",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["organiser", "artist"] },
        "bio": { "type": "string" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "location": { "type": "string" },
        "rating": { "type": "number" },
        "completedGigsCount": { "type": "number" },
        "portfolio": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "role", "createdAt"]
    },
    "Gig": {
      "title": "Gig",
      "description": "An event posting by an organiser",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organiserId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "budget": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "genre": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "filled", "completed", "cancelled"] },
        "acceptedApplicationId": { "type": "string" },
        "acceptedArtistId": { "type": "string" },
        "filledAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "cancelledByUid": { "type": "string" },
        "cancellationReason": { "type": "string", "enum": ["cancelled", "no_show"] },
        "noShowUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["organiserId", "title", "budget", "date", "status", "createdAt"]
    },
    "Application": {
      "title": "Application",
      "description": "An artist's application to a gig",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gigId": { "type": "string" },
        "artistId": { "type": "string" },
        "organiserId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "cancelled"] },
        "appliedAt": { "type": "string", "format": "date-time" },
        "status_updatedAt": { "type": "string" }
      },
      "required": ["gigId", "artistId", "organiserId", "status", "appliedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A rating and review after a gig is completed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gigId": { "type": "string" },
        "fromUid": { "type": "string" },
        "toUid": { "type": "string" },
        "score": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gigId", "fromUid", "toUid", "score", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Profile data for users"
    },
    "/gigs/{gigId}": {
      "schema": "Gig",
      "description": "Global list of all gigs"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Applications mapping artists to jobs"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Post-gig marketplace trust signals"
    }
  }
}
